server {
    listen 80;
    server_name _;

    # 静的ファイルの直接配信（パフォーマンス向上）
    location /static/ {
        alias /var/www/{{ proj_name }}/static/;
    }

    location /media/ {
        alias /var/www/{{ proj_name }}/media/;
    }

    # 動的リクエストを App サーバー（vagrant2）の Gunicorn へ転送
    location / {
        proxy_pass http://192.168.33.12:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
